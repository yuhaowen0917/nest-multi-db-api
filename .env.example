# 服务
PORT=3000
NODE_ENV=development

# MySQL 数据库
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=blog

# PostgreSQL 数据库
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASS=your_postgres_password
PG_DB=pg_sequelize_db

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Swagger
SWAGGER_ENABLE=true

# WebSocket
WS_ORIGIN=*
